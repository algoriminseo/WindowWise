<UserControl x:Class="WindowWise.Controls.FeatureCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowWise.Localization" x:Name="Root"
             Foreground="{StaticResource TextBrush}"
             Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:AppText.Current}, ConverterCulture=en-US}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Viewbox Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0">
                <Path Width="24" Height="24" Data="{Binding IconData, ElementName=Root}"
                      Stroke="{StaticResource PrimaryBrush}" Style="{StaticResource FeatureIconStyle}" />
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center">
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Title, ElementName=Root}" />
                <TextBlock Margin="0,7,0,0" FontSize="13" LineHeight="21" Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding Description, ElementName=Root}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Click="ActionButton_Click" VerticalAlignment="Center" MinWidth="146"
                    Style="{StaticResource FeatureButtonStyle}">
                <TextBlock Text="{Binding ActionText, ElementName=Root}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </Grid>
    </Border>
</UserControl>
