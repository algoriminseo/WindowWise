<UserControl x:Class="WindowWise.Controls.AccountMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="AccountButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F1F5F9" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EEF4FF" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Button x:Name="AccountButton" Style="{StaticResource AccountButtonStyle}" Click="Account_Click"
            AutomationProperties.Name="Account menu" ContextMenuOpening="Account_ContextMenuOpening">
        <Button.ContextMenu>
            <ContextMenu x:Name="AccountDropdown" MinWidth="238" Background="White" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6" Opened="Dropdown_Opened">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="Account settings" Click="Settings_Click">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Alerts">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" /></MenuItem.Icon>
                    <MenuItem x:Name="AudioAlertsItem" Header="Audio device alerts" IsCheckable="True" Click="AudioAlerts_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Sign out" Foreground="#B91C1C" Click="SignOut_Click">
                    <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8AC;" /></MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Button.ContextMenu>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="16" Background="#EEF4FF" Margin="0,0,10,0">
                <TextBlock x:Name="AvatarText" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="AccountEmail" Text="Sign in" FontSize="12" FontWeight="SemiBold" MaxWidth="250"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="DropdownArrow" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                       Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" />
        </StackPanel>
    </Button>
</UserControl>
