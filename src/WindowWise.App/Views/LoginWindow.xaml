<Window x:Class="WindowWise.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowWise.Localization"
        Title="{loc:T Common.SignInWindowWise}" Icon="/WindowWise;component/Assets/WindowWiseIcon.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic" Foreground="{StaticResource TextBrush}"
             Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:AppText.Current}, ConverterCulture=en-US}">
    <Window.Resources>
        <Style x:Key="SignInButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{StaticResource PrimaryFillBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#3B68C6" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#274B97" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28" Style="{StaticResource PageTransitionStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <Image Source="/WindowWise;component/Assets/WindowWiseIcon.ico" Width="28" Height="28" Margin="0,0,10,0" />
            <TextBlock Text="WindowWise" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <controls:LanguageSelector xmlns:controls="clr-namespace:WindowWise.Controls" HorizontalAlignment="Right" VerticalAlignment="Top" />
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24">
            <StackPanel>
                <TextBlock Text="{loc:T Common.SignInToShare}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{loc:T Common.ContinueInYourBrowserWithGoogleOr}" Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,10,0,24" FontSize="13" TextWrapping="Wrap" />
                <Button x:Name="LoginButton" Content="{loc:T Common.ContinueToSignIn}" Style="{StaticResource SignInButtonStyle}" Click="Login_Click" />
                <ProgressBar x:Name="LoginProgress" Height="3" Margin="0,20,0,0" IsIndeterminate="True"
                             Foreground="{StaticResource PrimaryBrush}" Visibility="Collapsed" AutomationProperties.Name="{loc:T Common.SigningIn}" />
                <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
