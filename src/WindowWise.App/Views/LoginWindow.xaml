<Window x:Class="WindowWise.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — WindowWise" Icon="/WindowWise;component/Assets/WindowWiseIcon.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F4F6F8" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="SignInButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#1D4ED8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#1E40AF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#18212F" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <Image Source="/WindowWise;component/Assets/WindowWiseIcon.ico" Width="28" Height="28" Margin="0,0,10,0" />
            <TextBlock Text="WindowWise" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24">
            <StackPanel>
                <TextBlock Text="Sign in to share" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Use Google or your email to continue." Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,10,0,24" FontSize="13" TextWrapping="Wrap" />
                <Button x:Name="LoginButton" Content="Continue to sign in" Style="{StaticResource SignInButtonStyle}" Click="Login_Click" />
                <ProgressBar x:Name="LoginProgress" Height="3" Margin="0,20,0,0" IsIndeterminate="True"
                             Foreground="{StaticResource PrimaryBrush}" Visibility="Collapsed" AutomationProperties.Name="Signing in" />
                <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
