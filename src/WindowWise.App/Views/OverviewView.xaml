<UserControl x:Class="WindowWise.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WindowWise.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="30,0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="HeaderStatusText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBarStyle}" />
            </ScrollViewer.Resources>
            <StackPanel Margin="30,28,30,36">
                <TextBlock x:Name="GreetingText" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                           Text="Your Windows workspace is ready." />
                <ScrollViewer Margin="0,26,0,0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource HorizontalScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <controls:FeatureCard Width="280" Margin="0,0,16,0"
                            Title="Smart Clipboard" Description="Search, organize and safely reuse clipboard items."
                            ActionText="Open clipboard" IconData="{StaticResource ClipboardIconGeometry}"
                            ActionClick="SmartClipboardCard_ActionClick" />
                        <controls:FeatureCard Width="280" Margin="0,0,16,0"
                            Title="Window Audio Manager" Description="Manage devices, battery status and app volume presets."
                            ActionText="Open audio manager" IconData="{StaticResource AudioIconGeometry}"
                            ActionClick="AudioManagerCard_ActionClick" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Margin="0,22,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Recent activity" />
                            <ItemsControl x:Name="ActivityList"
                                          Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Left"
                                                    Background="#EEF4FF"
                                                    CornerRadius="6">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="#2563EB"
                                                           Text="{Binding IconText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="13"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding Detail}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Margin="12,0,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding RelativeTimeText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyActivityText"
                                       Margin="0,18,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="No recent activity yet." />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
