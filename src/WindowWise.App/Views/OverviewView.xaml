<UserControl x:Class="WindowWise.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowWise.Localization"
             xmlns:controls="clr-namespace:WindowWise.Controls"
             Foreground="{StaticResource TextBrush}"
             Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:AppText.Current}, ConverterCulture=en-US}">
    <Grid Style="{StaticResource PageTransitionStyle}" Background="{StaticResource CanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBarStyle}" />
            </ScrollViewer.Resources>
            <StackPanel Margin="32,30,32,36">
                <StackPanel Margin="0,8,0,36">
                    <TextBlock x:Name="HeaderStatusText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                    <TextBlock x:Name="GreetingText" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource PageDescriptionStyle}"
                               Text="{loc:T Common.YourClipboardAudioAndFileSharingIn}" />
                </StackPanel>
                <TextBlock Text="{loc:T Common.YourTools}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" />
                <StackPanel>
                    <controls:FeatureCard Title="{loc:T Common.SmartClipboard}"
                        Description="{loc:T Common.FindCopiedTextAndLinksSelectAn}"
                        ActionText="{loc:T Common.OpenClipboard}" IconData="{StaticResource ClipboardIconGeometry}"
                        ActionClick="SmartClipboardCard_ActionClick" />
                    <controls:FeatureCard Title="{loc:T Common.AudioManager}"
                        Description="{loc:T Common.ChooseAnOutputDeviceAdjustVolumeAnd}"
                        ActionText="{loc:T Common.OpenAudioManager}" IconData="{StaticResource AudioIconGeometry}"
                        ActionClick="AudioManagerCard_ActionClick" />
                    <controls:FeatureCard Title="WindowWise Drop"
                        Description="{loc:T Common.SendFilesNearbyOrConnectOverThe}"
                        ActionText="{loc:T Common.OpenFileSharing}"
                        IconData="M4,7 H15 M11,3 L15,7 L11,11 M20,17 H9 M13,13 L9,17 L13,21"
                        ActionClick="FileSharingCard_ActionClick" />
                </StackPanel>
                <Grid Margin="0,24,0,0">
                    <Border Padding="4,8" BorderThickness="0">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{loc:T Common.RecentActivity}" />
                            <ItemsControl x:Name="ActivityList"
                                          Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    CornerRadius="6">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           Text="{Binding IconText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="13"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Text="{Binding LocalizedTitle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding LocalizedDetail}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Margin="12,0,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding RelativeTimeText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyActivityText"
                                       Margin="0,18,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{loc:T Common.NoActivityYetCopyTextOrA}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
