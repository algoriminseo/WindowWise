<Window x:Class="WindowWise.Views.DefaultDeviceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Default output device"
        Width="456"
        Height="184"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Window.Resources>
        <DropShadowEffect x:Key="OverlayShadow"
                          BlurRadius="28"
                          Direction="270"
                          ShadowDepth="8"
                          Color="#203750"
                          Opacity="0.38" />

        <Style x:Key="VolumeProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="#4DFFFFFF"
                                    CornerRadius="3.5" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="White"
                                    CornerRadius="3.5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Speaker version -->
        <DataTemplate x:Key="SpeakerOverlayTemplate">
            <Border Width="420"
                    Height="148"
                    CornerRadius="24"
                    BorderBrush="#70FFFFFF"
                    BorderThickness="1.25"
                    Effect="{StaticResource OverlayShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#EB57D1D5" />
                        <GradientStop Offset="0.48" Color="#EB34B7CE" />
                        <GradientStop Offset="1" Color="#EC2189C1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ClipToBounds="True">
                    <Canvas IsHitTestVisible="False" Opacity="0.13">
                        <Path Data="M-8,126 L126,-8 M82,156 L250,-12 M248,158 L430,-24"
                              Stroke="White"
                              StrokeThickness="1.4" />
                        <Ellipse Canvas.Left="278"
                                 Canvas.Top="-72"
                                 Width="190"
                                 Height="190"
                                 Stroke="White"
                                 StrokeThickness="1.2" />
                        <Rectangle Canvas.Left="365"
                                   Canvas.Top="94"
                                   Width="34"
                                   Height="34"
                                   RadiusX="7"
                                   RadiusY="7"
                                   Stroke="White"
                                   StrokeThickness="1.3"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="12" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>

                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="66"
                                Height="66"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#2D075994"
                                BorderBrush="#4DFFFFFF"
                                BorderThickness="1"
                                CornerRadius="20">
                            <Grid>
                                <Path Data="M7,17 H13 L21,10 V30 L13,23 H7 Z"
                                      Width="30"
                                      Height="30"
                                      Fill="White"
                                      Stretch="Uniform" />
                                <Path Data="M25,14 C28,16 29,18 29,20 C29,22 28,24 25,26 M29,10 C34,13 36,16 36,20 C36,24 34,27 29,30"
                                      Width="28"
                                      Height="28"
                                      Margin="17,0,0,0"
                                      Stroke="White"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="DEFAULT OUTPUT · SPEAKER"
                                       Foreground="#D9F7FFFF"
                                       FontSize="11"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,5,0,0"
                                       Text="{Binding Name}"
                                       d:Text="Speakers (Realtek Audio)"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />

                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>

                                <ProgressBar Value="{Binding Volume}"
                                             Style="{StaticResource VolumeProgressStyle}"
                                             VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Volume, StringFormat={}{0:0}%}"
                                           d:Text="72%"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Headphones version -->
        <DataTemplate x:Key="HeadphoneOverlayTemplate">
            <Border Width="420"
                    Height="148"
                    CornerRadius="24"
                    BorderBrush="#70FFFFFF"
                    BorderThickness="1.25"
                    Effect="{StaticResource OverlayShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#EC7976E8" />
                        <GradientStop Offset="0.48" Color="#EC586FD8" />
                        <GradientStop Offset="1" Color="#EB2D9CC7" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ClipToBounds="True">
                    <Canvas IsHitTestVisible="False" Opacity="0.13">
                        <Path Data="M-18,80 L104,-18 M54,166 L224,-8 M220,164 L438,-26"
                              Stroke="White"
                              StrokeThickness="1.4" />
                        <Ellipse Canvas.Left="290"
                                 Canvas.Top="-82"
                                 Width="205"
                                 Height="205"
                                 Stroke="White"
                                 StrokeThickness="1.2" />
                        <Rectangle Canvas.Left="362"
                                   Canvas.Top="94"
                                   Width="34"
                                   Height="34"
                                   RadiusX="7"
                                   RadiusY="7"
                                   Stroke="White"
                                   StrokeThickness="1.3"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-12" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>

                    <Grid Margin="24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="66"
                                Height="66"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#310B3D8B"
                                BorderBrush="#4DFFFFFF"
                                BorderThickness="1"
                                CornerRadius="20">
                            <Grid>
                                <Path Data="M7,21 V18 C7,10.8 12.8,5 20,5 C27.2,5 33,10.8 33,18 V21 M7,20 H12 V31 H9 C7.9,31 7,30.1 7,29 Z M33,20 H28 V31 H31 C32.1,31 33,30.1 33,29 Z"
                                      Width="34"
                                      Height="34"
                                      Fill="Transparent"
                                      Stroke="White"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="DEFAULT OUTPUT · HEADPHONES"
                                       Foreground="#E7EDFFFF"
                                       FontSize="11"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,5,0,0"
                                       Text="{Binding Name}"
                                       d:Text="Headphones (Bluetooth Audio)"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />

                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>

                                <ProgressBar Value="{Binding Volume}"
                                             Style="{StaticResource VolumeProgressStyle}"
                                             VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Volume, StringFormat={}{0:0}%}"
                                           d:Text="64%"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 기본값은 스피커. 서비스에서 필요할 때 HeadphoneOverlayTemplate로 교체한다. -->
    <ContentControl x:Name="OverlayContent"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource SpeakerOverlayTemplate}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsHitTestVisible="False" />
</Window>
