<UserControl x:Class="WindowWise.Views.AudioManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowWise.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="950"
             mc:Ignorable="d"
             Foreground="{StaticResource TextBrush}"
             Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:AppText.Current}, ConverterCulture=en-US}">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextInputStyle}" />
        <SolidColorBrush x:Key="AudioPrimaryBrush" Color="#315CB7" />
        <SolidColorBrush x:Key="AudioPrimaryHoverBrush" Color="#3B68C6" />
        <SolidColorBrush x:Key="AudioSurfaceBrush" Color="#172334" />
        <SolidColorBrush x:Key="AudioPanelBrush" Color="#111B2A" />
        <SolidColorBrush x:Key="AudioIconSurfaceBrush" Color="#203452" />
        <SolidColorBrush x:Key="AudioTrackBrush" Color="#2A3B50" />

        <Style x:Key="AudioCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AudioSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="AudioPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource AudioPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource AudioPrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AudioPrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#52637C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchTrack" Background="{TemplateBinding Background}" CornerRadius="13">
                            <Ellipse x:Name="SwitchThumb"
                                     Width="20" Height="20" Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" Opacity="0.2" ShadowDepth="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AudioPrimaryBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" Background="{StaticResource AudioTrackBrush}" CornerRadius="2.5" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{StaticResource AudioPrimaryBrush}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="{TemplateBinding Background}" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="17" Height="17">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource AudioPrimaryBrush}" Stroke="#1F68BE" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Background" Value="{StaticResource AudioIconSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageTransitionStyle}" Background="{StaticResource AudioPanelBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,30,32,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,22">
                    <StackPanel Margin="0,0,100,0">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{loc:T Common.AudioManager}" />
                        <TextBlock Style="{StaticResource PageDescriptionStyle}" Margin="0,8,0,0"
                                   Text="{loc:T Common.ChooseYourOutputAdjustAppVolumesAnd}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource AudioSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE72C;" />
                            <TextBlock Text="{loc:T Common.Refresh}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" />

                <Grid Grid.Row="2" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Margin="0,0,0,14"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{loc:T Common.CurrentOutputDevice}" />

                        <Border Style="{StaticResource AudioCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource AudioIconTileStyle}">
                                    <Viewbox Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Width="24" Height="24"
                                              Data="{StaticResource AudioIconGeometry}"
                                              Stroke="{StaticResource MutedTextBrush}"
                                              Style="{StaticResource FeatureIconStyle}" />
                                    </Viewbox>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                               Text="{loc:DisplayBinding Path=AudioInfo.DefaultDevice.Name, Fallback=No Default Device}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Text="{loc:T Common.Active}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,0,10" FontSize="13" FontWeight="SemiBold" Text="{loc:T Common.MasterVolume}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Value="{Binding AudioInfo.DefaultDevice.Volume,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                Minimum="0"
                                                Maximum="100"
                                                Style="{StaticResource AudioSliderStyle}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding AudioInfo.DefaultDevice.Volume, StringFormat={}{0:0}%}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,28,0,14"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{loc:T Common.AvailableOutputDevices}" />

                        <ScrollViewer MaxHeight="420"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AudioInfo.AvailableDevices.Values}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,14" Style="{StaticResource AudioCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="205" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource AudioIconTileStyle}">
                                                    <Viewbox Width="34"
                                                             Height="34"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                                        <Path Width="24"
                                                              Height="24"
                                                              Data="{StaticResource AudioIconGeometry}"
                                                              Stroke="{StaticResource MutedTextBrush}"
                                                              Style="{StaticResource FeatureIconStyle}" />
                                                    </Viewbox>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               FontSize="13"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding Id, StringFormat=ID: {0}}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Margin="16,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Margin="0,0,0,9"
                                                               HorizontalAlignment="Right"
                                                               FontSize="13"
                                                               Text="{loc:DisplayBinding Path=Device.State, TranslateValue=True}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="42" />
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Value="{Binding Volume,
                                                                                Mode=TwoWay,
                                                                                UpdateSourceTrigger=PropertyChanged}"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                Style="{StaticResource AudioSliderStyle}" />
                                                        <TextBlock Grid.Column="1"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding Volume, StringFormat={}{0:0}%}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,14"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{loc:T Common.VolumePresets}" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="PresetNameInput"
                                     Height="40"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     MaxLength="50" VerticalAlignment="Top" />

                            <Button Grid.Column="2"
                                    Content="{loc:T Common.Save}"
                                    Click="Preset_Save_New"
                                    Style="{StaticResource AudioPrimaryButtonStyle}" />
                        </Grid>

                        <ScrollViewer MaxHeight="500"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PresetInfo.Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,14"
                                                Style="{StaticResource AudioCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            Orientation="Horizontal">
                                                    <Button Width="70"
                                                            Margin="0,0,4,0"
                                                            Content="{loc:T Common.Save}"
                                                            Click="Preset_Save"
                                                            Style="{StaticResource AudioPrimaryButtonStyle}" />
                                                    <Button Width="70"
                                                            Margin="0,0,4,0"
                                                            Content="{loc:T Common.Apply}"
                                                            Click="Preset_Apply"
                                                            Style="{StaticResource AudioPrimaryButtonStyle}" />
                                                    <Button Width="50"
                                                            Content="X"
                                                            Click="Preset_Delete"
                                                            Style="{StaticResource AudioPrimaryButtonStyle}" />
                        </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
