<UserControl x:Class="WindowWise.Views.RemoteFileSharingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:WindowWise.Localization"
             FontFamily="Segoe UI, Malgun Gothic">
  <UserControl.Resources>
    <localization:RemoteSharingText x:Key="RemoteText" />
    <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBarStyle}" />
    <Style x:Key="RemoteButton" TargetType="Button" BasedOn="{StaticResource FeatureButtonStyle}">
      <Setter Property="Height" Value="36" />
      <Setter Property="FontSize" Value="12" />
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="RemotePrimaryButton" TargetType="Button" BasedOn="{StaticResource RemoteButton}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8" /><Setter Property="FontSize" Value="12" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="NetworkModeOption" TargetType="RadioButton">
      <Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DCE3EF" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="OptionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Ellipse Width="12" Height="12" Stroke="#A0AEC0" VerticalAlignment="Top" Margin="0,3,0,0" />
            <Ellipse x:Name="SelectedDot" Width="6" Height="6" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Top" Margin="0,6,0,0" Visibility="Collapsed" />
            <ContentPresenter Grid.Column="1" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="#EEF4FF" /><Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter TargetName="SelectedDot" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OptionBorder" Property="BorderThickness" Value="2" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="OptionBorder" Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- App-specific protocol marks; vector paths stay sharp at Windows display scaling. -->
    <StreamGeometry x:Key="NetworkStunMark">M3,9 A9,9 0 0 1 20,6 M20,6 L20,2 M20,6 L16,6 M21,15 A9,9 0 0 1 4,18 M4,18 L4,22 M4,18 L8,18 M7,12 H17 M14,9 L17,12 L14,15</StreamGeometry>
    <StreamGeometry x:Key="NetworkTurnMark">M6,2 H18 V8 H6 Z M6,10 H18 V16 H6 Z M9,5 H10 M9,13 H10 M2,12 V21 H22 V12 M0,14 L2,12 L4,14 M20,14 L22,12 L24,14 M12,16 V21</StreamGeometry>
    <Style x:Key="NetworkMarkPath" TargetType="Path">
      <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" /><Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" /><Setter Property="Width" Value="23" /><Setter Property="Height" Value="20" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- The share list matches FileSharingView so local and remote sharing look and behave alike. -->
    <Style x:Key="DropButton" TargetType="Button">
      <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DropPrimaryButton" TargetType="Button" BasedOn="{StaticResource DropButton}">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DropModeButton" TargetType="Button" BasedOn="{StaticResource DropButton}">
      <Setter Property="Height" Value="74" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="DropListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F8FC" /></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Surface" Property="Background" Value="#EEF4FF" /><Setter TargetName="Surface" Property="BorderBrush" Value="#BFD3FB" />
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DropList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource DropListItem}" />
    </Style>
    <DataTemplate x:Key="SharedFileTemplate">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PeerFileTemplate">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Foreground="{StaticResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Background="#F4F6F8" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontSize="13">
    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,0">
      <DockPanel VerticalAlignment="Center">
        <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="112"
                  SelectedIndex="1" SelectionChanged="Language_Changed" VerticalContentAlignment="Center"
                  AutomationProperties.Name="Display language / 화면 언어">
          <ComboBoxItem Content="한국어" /><ComboBoxItem Content="English" />
        </ComboBox>
        <Button x:Name="BackButton" Content="{Binding [Back], Source={StaticResource RemoteText}}" Style="{StaticResource RemoteButton}" Height="28" Margin="0,0,14,0" Click="Back_Click" />
        <TextBlock Text="WINDOWWISE DROP / REMOTE" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="30,24,30,22">
        <DockPanel Margin="0,0,0,6">
          <Border DockPanel.Dock="Right" Background="#EEF4FF" CornerRadius="5" Padding="10,5" HorizontalAlignment="Right">
            <TextBlock x:Name="RouteBadge" Text="WEBRTC" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="{Binding [Title], Source={StaticResource RemoteText}}" FontSize="26" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock Text="{Binding [Subtitle], Source={StaticResource RemoteText}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,20" />

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel Margin="0,0,0,16">
              <Border DockPanel.Dock="Right" Background="#F1F3F6" CornerRadius="5" Padding="10,5">
                <TextBlock x:Name="ConnectionBadge" Text="{Binding [Disconnected], Source={StaticResource RemoteText}}" FontSize="11" />
              </Border>
              <TextBlock Text="{Binding [Connection], Source={StaticResource RemoteText}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel x:Name="ConnectionFields">
              <TextBlock Text="{Binding [RoomLabel], Source={StaticResource RemoteText}}" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="RoomBox" MaxLength="24" AutomationProperties.Name="{Binding [RoomLabel], Source={StaticResource RemoteText}}" />
            </StackPanel>
            <StackPanel x:Name="NetworkFields" Margin="0,18,0,0">
              <TextBlock Text="{Binding [ConnectionMethod], Source={StaticResource RemoteText}}" Style="{StaticResource FieldLabel}" />
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <RadioButton x:Name="DirectModeBox" GroupName="NetworkMode" IsChecked="True" Checked="NetworkMode_Changed" Style="{StaticResource NetworkModeOption}" AutomationProperties.Name="{Binding [ModeDirect], Source={StaticResource RemoteText}}">
                  <StackPanel>
                    <DockPanel LastChildFill="True">
                      <Border x:Name="DirectModeLogo" DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,8,0" CornerRadius="6" Background="#E8F0FF" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center">
                          <Path Data="{StaticResource NetworkStunMark}" Style="{StaticResource NetworkMarkPath}" />
                          <TextBlock Text="P2P" FontFamily="Segoe UI" FontSize="8" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="DirectModeTitle" Text="{Binding [ModeDirect], Source={StaticResource RemoteText}}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TurnModeBox" Grid.Column="1" GroupName="NetworkMode" Checked="NetworkMode_Changed" Style="{StaticResource NetworkModeOption}" AutomationProperties.Name="{Binding [ModeTurn], Source={StaticResource RemoteText}}" ToolTip="TURN">
                  <StackPanel>
                    <DockPanel LastChildFill="True">
                      <Border x:Name="TurnModeLogo" DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,8,0" CornerRadius="6" Background="#E8F0FF" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center">
                          <Path Data="{StaticResource NetworkTurnMark}" Style="{StaticResource NetworkMarkPath}" />
                          <TextBlock Text="TURN" FontFamily="Segoe UI" FontSize="8" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="TurnModeTitle" Text="{Binding [ModeTurn], Source={StaticResource RemoteText}}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </RadioButton>
              </Grid>
              <Expander Header="{Binding [AdvancedConnection], Source={StaticResource RemoteText}}" Margin="0,2,0,0">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="{Binding [Server], Source={StaticResource RemoteText}}" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="ServerBox" Text="ws://localhost:5047/signal" AutomationProperties.Name="{Binding [Server], Source={StaticResource RemoteText}}" />
              <StackPanel x:Name="StunFields" Visibility="Collapsed">
                <TextBlock Text="{Binding [StunLabel], Source={StaticResource RemoteText}}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="StunBox" AcceptsReturn="True" MinHeight="56" MaxHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding [StunLabel], Source={StaticResource RemoteText}}" ToolTip="{Binding [StunExample], Source={StaticResource RemoteText}}" />
                <TextBlock Text="{Binding [NetworkHint], Source={StaticResource RemoteText}}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
              </StackPanel>
              <StackPanel x:Name="TurnFields" Visibility="Collapsed">
                <CheckBox x:Name="AutoTurnBox" IsChecked="True" Content="{Binding [AutoTurn], Source={StaticResource RemoteText}}" Checked="TurnSource_Changed" Unchecked="TurnSource_Changed" Margin="0,0,0,10" />
                <StackPanel x:Name="AutoTurnFields">
                  <TextBlock Text="{Binding [TurnApiUrl], Source={StaticResource RemoteText}}" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="TurnApiBox" AutomationProperties.Name="{Binding [TurnApiUrl], Source={StaticResource RemoteText}}" />
                  <TextBlock Text="{Binding [AutoTurnHint], Source={StaticResource RemoteText}}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,10" />
                </StackPanel>
                <StackPanel x:Name="ManualTurnFields" Visibility="Collapsed">
                  <TextBlock Text="{Binding [TurnUrls], Source={StaticResource RemoteText}}" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="TurnBox" AcceptsReturn="True" MinHeight="64" MaxHeight="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding [TurnUrls], Source={StaticResource RemoteText}}" ToolTip="{Binding [TurnExample], Source={StaticResource RemoteText}}" />
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding [TurnUsername], Source={StaticResource RemoteText}}" Style="{StaticResource FieldLabel}" />
                      <TextBox x:Name="TurnUsernameBox" AutomationProperties.Name="{Binding [TurnUsername], Source={StaticResource RemoteText}}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding [TurnCredential], Source={StaticResource RemoteText}}" Style="{StaticResource FieldLabel}" />
                      <PasswordBox x:Name="TurnCredentialBox" Padding="10,8" FontSize="12" AutomationProperties.Name="{Binding [TurnCredential], Source={StaticResource RemoteText}}" /></StackPanel>
                  </Grid>
                <TextBlock Text="{Binding [TurnHint], Source={StaticResource RemoteText}}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                </StackPanel>
                <CheckBox x:Name="RelayOnlyBox" Content="{Binding [RelayOnly], Source={StaticResource RemoteText}}" Margin="0,10,0,0" />
              </StackPanel>
              <Button x:Name="GatherButton" Content="{Binding [GatherIce], Source={StaticResource RemoteText}}" Click="GatherIce_Click" Style="{StaticResource RemoteButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
              </Expander>
            </StackPanel>
            <WrapPanel Margin="0,14,0,0">
              <Button x:Name="CreateRoomButton" Content="{Binding [CreateRoom], Source={StaticResource RemoteText}}" Style="{StaticResource RemotePrimaryButton}" Margin="0,0,8,6" Click="CreateRoom_Click" />
              <Button x:Name="ConnectButton" Content="{Binding [JoinRoom], Source={StaticResource RemoteText}}" Style="{StaticResource RemoteButton}" Margin="0,0,8,6" Click="Connect_Click" />
              <Button x:Name="CopyRoomButton" Content="{Binding [CopyRoom], Source={StaticResource RemoteText}}" Style="{StaticResource RemoteButton}" Margin="0,0,8,6" Click="CopyRoom_Click" IsEnabled="False" />
              <Button x:Name="DisconnectButton" Content="{Binding [Disconnect], Source={StaticResource RemoteText}}" Style="{StaticResource RemoteButton}" Margin="0,0,8,6" Click="Disconnect_Click" IsEnabled="False" />
              <Button x:Name="TestWindowButton" Content="{Binding [TestWindow], Source={StaticResource RemoteText}}" Style="{StaticResource RemoteButton}" Margin="0,0,0,6" Click="TestWindow_Click" />
            </WrapPanel>
            <TextBlock Text="{Binding [Instructions], Source={StaticResource RemoteText}}"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
            <TextBlock x:Name="RouteText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <Expander x:Name="DiagnosticsExpander" Header="{Binding [AdvancedDiagnostics], Source={StaticResource RemoteText}}">
          <StackPanel Margin="0,12,0,0">
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="{Binding [SaveDiagnostics], Source={StaticResource RemoteText}}" Click="SaveDiagnostics_Click" Style="{StaticResource RemoteButton}" />
              <TextBlock Text="{Binding [IceDiagnostics], Source={StaticResource RemoteText}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding [IceHint], Source={StaticResource RemoteText}}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" Foreground="{StaticResource MutedTextBrush}" />
            <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="180" FontFamily="Consolas" AutomationProperties.Name="{Binding [IceDiagnostics], Source={StaticResource RemoteText}}" />
          </StackPanel>
          </Expander>
        </Border>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button x:Name="ShareModeButton" Style="{StaticResource DropModeButton}" Click="ShareMode_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" FontSize="23" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" />
              <StackPanel><TextBlock Text="{Binding [ShareMode], Source={StaticResource RemoteText}}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{Binding [ShareModeHint], Source={StaticResource RemoteText}}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="ReceiveModeButton" Grid.Column="2" Style="{StaticResource DropModeButton}" Click="ReceiveMode_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="23" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" />
              <StackPanel><TextBlock Text="{Binding [ReceiveMode], Source={StaticResource RemoteText}}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{Binding [ReceiveModeHint], Source={StaticResource RemoteText}}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
            </StackPanel>
          </Button>
        </Grid>

        <Border x:Name="SharePanel" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Height="380">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding [FilesToShare], Source={StaticResource RemoteText}}" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ShareCountText" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="AddSharedButton" Style="{StaticResource DropButton}" Content="{Binding [AddShared], Source={StaticResource RemoteText}}" Click="AddShared_Click" />
                <Button x:Name="RemoveSharedButton" Style="{StaticResource DropButton}" Content="{Binding [RemoveShared], Source={StaticResource RemoteText}}" Margin="8,0,0,0" Click="RemoveShared_Click" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
              <ListBox x:Name="MySharedList" Style="{StaticResource DropList}" SelectionMode="Extended" ItemTemplate="{StaticResource SharedFileTemplate}" SelectionChanged="FileList_SelectionChanged" AutomationProperties.Name="{Binding [FilesToShare], Source={StaticResource RemoteText}}" />
              <StackPanel x:Name="ShareEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="12">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="38" Foreground="#A7B6CA" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding [ShareEmptyTitle], Source={StaticResource RemoteText}}" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,7" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding [ShareEmptyHint], Source={StaticResource RemoteText}}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock x:Name="SharingStateText" FontWeight="SemiBold" />
                  <TextBlock x:Name="SharingHintText" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="SharingButton" Grid.Column="1" Style="{StaticResource DropPrimaryButton}" MinWidth="104" Click="ToggleSharing_Click" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
              <TextBlock x:Name="ShareProgressText" Text="{Binding [Waiting], Source={StaticResource RemoteText}}" Margin="0,0,0,6" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
              <ProgressBar x:Name="ShareProgressBar" Height="4" Minimum="0" Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#E8EDF5" BorderThickness="0" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="ReceivePanel" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16" Height="380" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding [PeerFiles], Source={StaticResource RemoteText}}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="PeerFileCount" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
              <Button x:Name="RefreshPeerButton" Grid.Column="1" Style="{StaticResource DropButton}" Content="{Binding [RefreshPeer], Source={StaticResource RemoteText}}" Click="RefreshPeer_Click" />
            </Grid>
            <Grid Grid.Row="1">
              <ListBox x:Name="PeerFileList" Style="{StaticResource DropList}" SelectionMode="Extended" ItemTemplate="{StaticResource PeerFileTemplate}" SelectionChanged="FileList_SelectionChanged" AutomationProperties.Name="{Binding [PeerFiles], Source={StaticResource RemoteText}}" />
              <StackPanel x:Name="PeerEmptyState" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="34" Foreground="#A7B6CA" HorizontalAlignment="Center" />
                <TextBlock x:Name="PeerEmptyText" TextAlignment="Center" TextWrapping="Wrap" Margin="0,15,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding [SaveFolder], Source={StaticResource RemoteText}}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="DownloadFolderText" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                  <Button x:Name="ChooseFolderButton" Grid.Column="1" Style="{StaticResource DropButton}" Content="{Binding [ChangeFolder], Source={StaticResource RemoteText}}" Click="ChooseFolder_Click" />
                </Grid>
              </Border>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="DownloadButton" Style="{StaticResource DropPrimaryButton}" Content="{Binding [DownloadSelected], Source={StaticResource RemoteText}}" Click="Download_Click" />
                <Button x:Name="CancelDownloadButton" Grid.Column="1" Style="{StaticResource DropButton}" Content="{Binding [Cancel], Source={StaticResource RemoteText}}" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
              </Grid>
              <TextBlock x:Name="ReceiveProgressText" Text="{Binding [Waiting], Source={StaticResource RemoteText}}" Margin="0,12,0,6" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
              <ProgressBar x:Name="ReceiveProgressBar" Height="4" Minimum="0" Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#E8EDF5" BorderThickness="0" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="{Binding [History], Source={StaticResource RemoteText}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock x:Name="HistoryEmpty" Text="{Binding [HistoryEmpty], Source={StaticResource RemoteText}}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            <ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Text="{Binding [Ready], Source={StaticResource RemoteText}}" Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
