<UserControl x:Class="WindowWise.Views.SmartClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowWise.Localization"
             FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
             Foreground="{StaticResource TextBrush}"
             Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:AppText.Current}, ConverterCulture=en-US}">
    <UserControl.Resources>
        <Style x:Key="ModernClearButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="108" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetaChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="CategoryChipStyle" TargetType="Border" BasedOn="{StaticResource MetaChipStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardFilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionSurface" Background="Transparent" CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryBoxSurfaceStyle" TargetType="Border">
            <Setter Property="Height" Value="170" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FavoriteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{loc:T Common.Favorite}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmartClipboardVerticalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        Width="7"
                                                        HorizontalAlignment="Center"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="3.5" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Width" Value="8" />
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#7F8DA1" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Width" Value="8" />
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#4F5D72" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageTransitionStyle}" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="32,0" Background="{StaticResource CanvasBrush}">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border x:Name="MonitoringStatusBadge"
                            Padding="8,3"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MonitoringStatusDot"
                                     Width="7"
                                     Height="7"
                                     Fill="#22A06B" />
                            <TextBlock x:Name="MonitoringStatusText"
                                       Margin="7,0,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#8BC9AC"
                                       Text="{loc:T Common.MonitoringActive}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="FeedbackText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="32,20,32,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Margin="0,0,275,0">
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="{loc:T Common.SmartClipboard}" />
                    <TextBlock Margin="0,7,0,0" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                               Text="{loc:T Common.FindCopiedTextAndLinksSelectAn}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               Text="{loc:T Common.RepeatedCopiesMoveBackToTheTop}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Margin="0,0,10,0" Click="OpenCategories_Click"
                            MinWidth="136"
                            Style="{StaticResource ModernClearButtonStyle}" Content="{loc:T Common.Categories}" />
                    <Button Click="ClearAll_Click"
                            MinWidth="112"
                            Style="{StaticResource ModernClearButtonStyle}" Content="{loc:T Common.ClearAll}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,22,0,16" Padding="16,12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource PrimaryBrush}"
                                   Text="&#xE8C8;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                   Text="{loc:T Common.ClipboardHistory}" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource PrimaryBrush}"
                                   Text="{loc:T Common.SavedLocallyAndRestoredWhenWindowWiseOpens}" />
                    </StackPanel>
                    <Border Grid.Column="2" Padding="9,4" VerticalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" Text="{loc:T Common.ClickToCopy}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Margin="0,0,0,14" Height="42" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}" Text="&#xE721;" />
                        </Border>

                        <Grid Grid.Column="1">
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       IsHitTestVisible="False" Text="{loc:T Common.SearchClipboardHistory}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox x:Name="SearchTextBox"
                                     Margin="0,0,12,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Foreground="{StaticResource TextBrush}"
                                     TextChanged="SearchTextBox_TextChanged"
                                     Text="" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,14" Padding="4" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:T Common.All}"
                                Click="AllFilter_Click"
                                Style="{StaticResource ClipboardFilterButtonStyle}" />
                        <Button Content="{loc:T Common.Favorites}"
                                Click="FavoritesFilter_Click"
                                Style="{StaticResource ClipboardFilterButtonStyle}" />
                        <Button Content="{loc:T Common.Links}"
                                Click="LinksFilter_Click"
                                Style="{StaticResource ClipboardFilterButtonStyle}" />
                        <Button Content="{loc:T Common.Text}"
                                Click="TextFilter_Click"
                                Style="{StaticResource ClipboardFilterButtonStyle}" />
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredItems}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SmartClipboardVerticalScrollBarStyle}" />
                        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ClipboardCardStyle}"
                                    MouseLeftButtonUp="HistoryItem_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button VerticalAlignment="Top" Click="FavoriteItem_Click"
                                            Style="{StaticResource FavoriteButtonStyle}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE734;" />
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="&#xE735;" />
                                                            <Setter Property="Foreground" Value="#D9B86A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock MaxHeight="104" FontSize="14" LineHeight="21"
                                                   Foreground="{StaticResource TextBrush}" Text="{Binding DisplayContent}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,13,0,0" Orientation="Horizontal">
                                            <Border Style="{StaticResource MetaChipStyle}">
                                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{loc:DisplayBinding Path=ContentType, TranslateValue=True}" />
                                            </Border>
                                            <Border Margin="8,0,0,0" Style="{StaticResource CategoryChipStyle}">
                                                <Border.BorderBrush>
                                                    <Binding Path="CategoryColorHex" />
                                                </Border.BorderBrush>
                                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding CategoryColorHex}"
                                                           Text="{Binding Category}" />
                                            </Border>
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding CopiedAt, StringFormat='{}{0:MMM d, h:mm tt}'}" />
                                        </StackPanel>
                                        <TextBox Margin="0,8,0,0" Padding="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Cursor="IBeam"
                                                 FontSize="11"
                                                 Foreground="{StaticResource MutedTextBrush}"
                                                 IsReadOnly="True"
                                                 IsTabStop="False"
                                                 MouseLeftButtonUp="SourceTextBox_MouseLeftButtonUp"
                                                 Text="{loc:DisplayBinding Path=SourceDisplayText, Format=Common.From}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top">
                                        <Button HorizontalAlignment="Right"
                                                Click="DeleteItem_Click" Style="{StaticResource ClipboardIconButtonStyle}"
                                                ToolTip="{loc:T Common.RemoveFromHistory}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE74D;" />
                                        </Button>
                                        <Button Margin="0,10,0,0"
                                                MinWidth="142"
                                                Click="AddItemToCategory_Click"
                                                Style="{StaticResource ClipboardFilterButtonStyle}"
                                                Content="{loc:T Common.AddToCategory}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="54" Height="54" HorizontalAlignment="Center" Background="{StaticResource SurfaceBrush}" CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource PrimaryBrush}"
                                   Text="&#xE8C8;" />
                    </Border>
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Text="{loc:T Common.NothingCopiedYet}" />
                        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{loc:T Common.CopyTextOrALinkAndIt}" />
                </StackPanel>

                <Border Grid.Column="2" Grid.RowSpan="3" Padding="16" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{loc:T Common.ProtectionLog}" />
                            <TextBlock Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{loc:T Common.SensitiveItemsThatNeedAttention}" />
                        </StackPanel>

                        <ListBox Grid.Row="1" Margin="0,10,0,0"
                                 ItemsSource="{Binding SensitiveItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SmartClipboardVerticalScrollBarStyle}" />
                                <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="7">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#F0A5A5"
                                                           Text="{Binding ProtectionStatus}" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="10"
                                                           Foreground="#F0A5A5"
                                                           Text="{Binding CopiedAt, StringFormat='{}{0:MMM d, h:mm tt}'}" />
                                            </Grid>
                                            <TextBlock Margin="0,6,0,0" FontSize="11"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Text="{loc:DisplayBinding Path=SensitiveReason, TranslateValue=True}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,5,0,0" FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{loc:DisplayBinding Path=SourceAppDisplayName, Format=Common.From}" />
                                            <TextBlock Margin="0,6,0,0" MaxHeight="32" FontSize="10"
                                                       LineHeight="15"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Text="{Binding DisplayContent}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <WrapPanel.Style>
                                                    <Style TargetType="WrapPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsUserConfirmation}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </WrapPanel.Style>
                                                <Button Height="28"
                                                        MinWidth="112"
                                                        Padding="14,0"
                                                        Margin="0,0,6,6"
                                                        Click="BlockSensitiveItem_Click"
                                                        Style="{StaticResource ClipboardFilterButtonStyle}"
                                                        Content="{loc:T Common.BlockContent}" />
                                                <Button Height="28"
                                                        MinWidth="112"
                                                        Padding="14,0"
                                                        Margin="0,0,6,6"
                                                        Click="KeepSensitiveItemProtected_Click"
                                                        Style="{StaticResource ClipboardFilterButtonStyle}"
                                                        Content="{loc:T Common.KeepProtected}" />
                                                <Button Height="28"
                                                        MinWidth="112"
                                                        Padding="14,0"
                                                        Margin="0,0,6,6"
                                                        Click="MarkSensitiveItemNormal_Click"
                                                        Style="{StaticResource ClipboardFilterButtonStyle}"
                                                        Content="{loc:T Common.ShowContent}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="CategoryOverlay" Grid.RowSpan="2" Background="#990B1220" Visibility="Collapsed">
            <Border Width="920" Height="610" Padding="22" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Text="{loc:T Common.ClipboardCategories}" />
                            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource PrimaryBrush}"
                                       Text="{loc:T Common.GroupSavedClipboardItemsSoTheyAre}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CloseCategories_Click"
                                Style="{StaticResource ClipboardIconButtonStyle}"
                                ToolTip="{loc:T Common.CloseCategories}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE711;" />
                        </Button>
                    </Grid>

                    <Border x:Name="PendingCategoryItemBox"
                            Grid.Row="1"
                            Margin="0,16,0,0"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                           Text="{loc:T Common.SelectedClipboardItem}" />
                                <Border Margin="0,8,0,0" Padding="12" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock x:Name="PendingCategoryContentText"
                                               MaxHeight="66"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               LineHeight="18"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CategoryEditorBox" Grid.Row="2" Margin="0,16,0,16" Padding="16" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <TextBox x:Name="CategoryNameTextBox"
                                         Height="38"
                                         Padding="11,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         FontSize="13"
                                         Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False"
                                           Text="{loc:T Common.CategoryName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CategoryNameTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Click="AddCategoryRule_Click"
                                    Style="{StaticResource ModernClearButtonStyle}" Content="{loc:T Common.AddBox}" />

                            <Grid Grid.Column="3">
                                <TextBox x:Name="CategorySearchTextBox"
                                         Height="38"
                                         Padding="11,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         FontSize="13"
                                         Foreground="{StaticResource TextBrush}"
                                         TextChanged="CategorySearchTextBox_TextChanged" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False"
                                           Text="{loc:T Common.SearchCategoriesByName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CategorySearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="SelectedCategoryColorPreview"
                                            Width="28" Height="28" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{loc:T Common.Color}" />
                                </StackPanel>
                                <UniformGrid Margin="0,9,0,0" Columns="12" Rows="2">
                                    <Button Height="24" Margin="0,0,7,7" Background="#2563EB" BorderBrush="{StaticResource BorderBrush}" Tag="#2563EB" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Blue}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#0EA5E9" BorderBrush="{StaticResource BorderBrush}" Tag="#0EA5E9" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Sky}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#0891B2" BorderBrush="{StaticResource BorderBrush}" Tag="#0891B2" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Cyan}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#0F766E" BorderBrush="{StaticResource BorderBrush}" Tag="#0F766E" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Teal}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#22A06B" BorderBrush="{StaticResource BorderBrush}" Tag="#22A06B" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Green}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#10B981" BorderBrush="{StaticResource BorderBrush}" Tag="#10B981" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Mint}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#65A30D" BorderBrush="{StaticResource BorderBrush}" Tag="#65A30D" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Lime}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#CA8A04" BorderBrush="{StaticResource BorderBrush}" Tag="#CA8A04" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Yellow}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#D97706" BorderBrush="{StaticResource BorderBrush}" Tag="#D97706" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Amber}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#EA580C" BorderBrush="{StaticResource BorderBrush}" Tag="#EA580C" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Orange}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#DC2626" BorderBrush="{StaticResource BorderBrush}" Tag="#DC2626" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Red}" />
                                    <Button Height="24" Margin="0,0,7,7" Background="#E11D48" BorderBrush="{StaticResource BorderBrush}" Tag="#E11D48" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Rose}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#DB2777" BorderBrush="{StaticResource BorderBrush}" Tag="#DB2777" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Pink}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#BE185D" BorderBrush="{StaticResource BorderBrush}" Tag="#BE185D" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Magenta}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#9333EA" BorderBrush="{StaticResource BorderBrush}" Tag="#9333EA" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Purple}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#7C3AED" BorderBrush="{StaticResource BorderBrush}" Tag="#7C3AED" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Violet}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#4F46E5" BorderBrush="{StaticResource BorderBrush}" Tag="#4F46E5" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Indigo}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#1E40AF" BorderBrush="{StaticResource BorderBrush}" Tag="#1E40AF" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Navy}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#334155" BorderBrush="{StaticResource BorderBrush}" Tag="#334155" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Slate}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#6B7280" BorderBrush="{StaticResource BorderBrush}" Tag="#6B7280" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Gray}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#78716C" BorderBrush="{StaticResource BorderBrush}" Tag="#78716C" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Stone}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#A16207" BorderBrush="{StaticResource BorderBrush}" Tag="#A16207" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Ochre}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#92400E" BorderBrush="{StaticResource BorderBrush}" Tag="#92400E" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Brown}" />
                                    <Button Height="24" Margin="0,0,7,0" Background="#111827" BorderBrush="{StaticResource BorderBrush}" Tag="#111827" Click="CategoryColorSwatch_Click" ToolTip="{loc:T Common.Ink}" />
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                               Text="{loc:T Common.CategoryBoxes}" />
                                    <TextBlock x:Name="CategoryAddInstructionText"
                                               Margin="0,4,0,0" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{loc:T Common.ChooseACategoryThenClickAddHere}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <ListBox x:Name="CategoryListBox"
                                         Grid.Row="1"
                                         Margin="0,14,0,0"
                                         ItemsSource="{Binding CategoryRules}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         SelectionChanged="CategoryListBox_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource CategoryCardItemStyle}" />
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CategoryBoxSurface"
                                                    Style="{StaticResource CategoryBoxSurfaceStyle}"
                                                    BorderBrush="{Binding ColorHex}"
                                                    MouseLeftButtonUp="CategoryBox_MouseLeftButtonUp">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border x:Name="CategoryBoxHoverTint"
                                                            Grid.RowSpan="5"
                                                            Margin="-12"
                                                            Background="{Binding ColorHex}"
                                                            CornerRadius="9"
                                                            IsHitTestVisible="False"
                                                            Opacity="0" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28" HorizontalAlignment="Left"
                                                                Background="{Binding ColorHex}" CornerRadius="8">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="#FFFFFF" Text="&#xE8EC;" />
                                                        </Border>
                                                        <Button Grid.Column="1"
                                                                Click="DeleteCategoryRule_Click"
                                                                Style="{StaticResource ClipboardIconButtonStyle}"
                                                                ToolTip="{loc:T Common.DeleteCategory}">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE74D;" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Margin="0,10,0,0" FontSize="14"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <StackPanel Grid.Row="2" Margin="0,7,0,0" Orientation="Horizontal">
                                                        <Border Padding="7,3" Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                                                            <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Text="{Binding ItemCountLabel}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <ScrollViewer Grid.Row="3" Margin="0,8,0,0" MaxHeight="72"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,6" Padding="7" Background="{StaticResource SurfaceBrush}"
                                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock MaxHeight="34" FontSize="11" LineHeight="16"
                                                                                       Foreground="{StaticResource TextBrush}"
                                                                                       Text="{Binding DisplayContent}" TextWrapping="Wrap"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                                <Button MinWidth="58"
                                                                                        Click="CopyCategoryItem_Click"
                                                                                        Style="{StaticResource ClipboardFilterButtonStyle}"
                                                                                        Content="{loc:T Common.Copy}" />
                                                                                <Button MinWidth="58"
                                                                                        Margin="0,5,0,0"
                                                                                        Click="RemoveCategoryItem_Click"
                                                                                        Style="{StaticResource ClipboardFilterButtonStyle}"
                                                                                        Content="{loc:T Common.Remove}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <Button Grid.Row="4"
                                                            Margin="0,6,0,0"
                                                            Click="AssignPendingItemToCategory_Click"
                                                            Style="{StaticResource ModernClearButtonStyle}"
                                                            Content="{loc:T Common.AddHere}"
                                                            Visibility="{Binding Visibility, ElementName=PendingCategoryItemBox}" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="CategoryBoxSurface" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CategoryBoxHoverTint" Property="Opacity" Value="0.08" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SelectedCategoryTitle" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Text="{loc:T Common.SelectACategory}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                               Text="{loc:T Common.ItemsInThatCategoryAppearHere}" />
                                </StackPanel>

                                <ListBox Grid.Row="1" Margin="0,14,0,0"
                                         ItemsSource="{Binding SelectedCategoryItems}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="False"
                                         VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListBox.Resources>
                                        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,10" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border MinHeight="86" Padding="14" Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="13" LineHeight="20"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   Text="{Binding DisplayContent}" TextWrapping="Wrap" />
                                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                            <Border Padding="8,4" Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                                                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           Text="{loc:DisplayBinding Path=ContentType, TranslateValue=True}" />
                                                            </Border>
                                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                                       Text="{Binding CopiedAt, StringFormat='{}{0:MMM d, h:mm tt}'}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                                                        <Button Click="CopyCategoryItem_Click"
                                                                Style="{StaticResource ModernClearButtonStyle}"
                                                                Content="{loc:T Common.Copy}" />
                                                        <Button Margin="0,8,0,0"
                                                                Click="RemoveCategoryItem_Click"
                                                                Style="{StaticResource ModernClearButtonStyle}"
                                                                Content="{loc:T Common.Remove}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
