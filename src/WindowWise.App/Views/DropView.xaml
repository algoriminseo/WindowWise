<UserControl x:Class="WindowWise.Views.DropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowWise.Localization"
             FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
             Foreground="{StaticResource TextBrush}"
             Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:AppText.Current}, ConverterCulture=en-US}">
    <UserControl.Resources>
        <Style x:Key="DropEntryButton" TargetType="Button" BasedOn="{StaticResource FeatureButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource CanvasBrush}" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontSize="14">
        <Grid x:Name="SelectionPanel" Style="{StaticResource PageTransitionStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,30,32,32">
                    <TextBlock Text="{loc:T Common.FileSharing}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{loc:T Common.ChooseWhereTheOtherDeviceIsAdd}"
                               Margin="0,10,0,30" Style="{StaticResource PageDescriptionStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="28">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="96" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="32" Height="32" CornerRadius="0" Background="Transparent" HorizontalAlignment="Left" Margin="0,0,0,24">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE968;" FontSize="24"
                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:T Common.OnTheSameNetwork}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="{loc:T Common.ExchangeFilesWithNearbyDevicesOnThe}"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,20" />
                                <Button x:Name="LocalSharingButton" Grid.Row="3" Content="{loc:T Common.OpenLocalFileSharing}"
                                        Style="{StaticResource DropEntryButton}" Click="LocalSharing_Click" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="28" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="96" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="32" Height="32" CornerRadius="0" Background="Transparent" HorizontalAlignment="Left" Margin="0,0,0,24">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="24"
                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:T Common.AcrossTheInternet}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="{loc:T Common.CreateARoomAndShareItsCode}"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,20" />
                                <Button x:Name="RemoteSharingButton" Grid.Row="3" Content="{loc:T Common.OpenRemoteFileSharing}"
                                        Style="{StaticResource DropEntryButton}" Background="{StaticResource PrimaryFillBrush}"
                                        Foreground="White" BorderBrush="{StaticResource PrimaryFillBrush}" Click="RemoteSharing_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <ContentControl x:Name="LocalContent" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
