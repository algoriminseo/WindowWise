<Window x:Class="WindowWise.Views.AccountSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account settings — WindowWise" Icon="/WindowWise;component/Assets/WindowWiseIcon.ico"
        Width="470" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F4F6F8" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="Account settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="NAME" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="ProfileName" FontSize="15" Margin="0,6,0,18" TextWrapping="Wrap" />
                <TextBlock Text="EMAIL" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="ProfileEmail" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Alerts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox x:Name="AudioAlertsBox" Content="Audio device alerts" Click="AudioAlerts_Click" />
                <TextBlock Text="Show an overlay when your default audio device changes."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="#B91C1C" Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Button Content="Done" IsCancel="True" HorizontalAlignment="Right" MinWidth="84" Margin="0,20,0,0"
                Style="{StaticResource FeatureButtonStyle}" />
    </StackPanel>
</Window>
