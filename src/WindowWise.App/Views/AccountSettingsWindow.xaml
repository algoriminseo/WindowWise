<Window x:Class="WindowWise.Views.AccountSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowWise.Localization"
        Title="{loc:T Common.AccountSettingsWindowWise}" Icon="/WindowWise;component/Assets/WindowWiseIcon.ico"
        Width="470" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI, Malgun Gothic" Foreground="{StaticResource TextBrush}"
             Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:AppText.Current}, ConverterCulture=en-US}">
    <StackPanel Margin="28">
        <DockPanel Margin="0,0,0,20">
            <controls:LanguageSelector xmlns:controls="clr-namespace:WindowWise.Controls" DockPanel.Dock="Right" />
            <TextBlock Text="{loc:T Common.AccountSettings}" FontSize="24" FontWeight="SemiBold" />
        </DockPanel>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{loc:T Common.NAME}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="ProfileName" FontSize="15" Margin="0,6,0,18" TextWrapping="Wrap" />
                <TextBlock Text="{loc:T Common.EMAIL}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="ProfileEmail" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{loc:T Common.Alerts}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox x:Name="AudioAlertsBox" Content="{loc:T Common.AudioDeviceAlerts}" Click="AudioAlerts_Click" />
                <TextBlock Text="{loc:T Common.ShowAnOverlayWhenYourDefaultAudio}"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="#F0A5A5" Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Button Content="{loc:T Common.Done}" IsCancel="True" HorizontalAlignment="Right" MinWidth="84" Margin="0,20,0,0"
                Style="{StaticResource FeatureButtonStyle}" />
    </StackPanel>
</Window>
