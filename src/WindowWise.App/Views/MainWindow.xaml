<Window x:Class="WindowWise.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WindowWise.Localization"
        xmlns:controls="clr-namespace:WindowWise.Controls"
        Title="WindowWise" Icon="/Assets/WindowWiseIcon.ico"
        Width="1240" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
             Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:AppText.Current}, ConverterCulture=en-US}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="108" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="Transparent" CornerRadius="0" Width="36" Height="36" Margin="0,0,10,0">
                            <Image Width="25" Height="25" Source="/Assets/WindowWiseIcon.ico" Stretch="Uniform" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Text="WindowWise" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               Text="{loc:T Common.YourEverydayWindowsTools}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Margin="26,12,0,12" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" Text="{loc:T Common.Workspace}" />
                    <Button x:Name="OverviewButton" Click="OverviewButton_Click"
                            Style="{StaticResource PrimaryNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="28" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE80F;" />
                            <TextBlock Text="{loc:T Common.Overview}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SmartClipboardButton" Click="SmartClipboardButton_Click"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Path Width="24" Height="24" Data="{StaticResource ClipboardIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Style="{StaticResource FeatureIconStyle}" />
                            </Viewbox>
                            <TextBlock Text="{loc:T Common.SmartClipboard}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AudioManagerButton" Click="AudioManagerButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Path Width="24" Height="24" Data="{StaticResource AudioIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Style="{StaticResource FeatureIconStyle}" />
                            </Viewbox>
                            <TextBlock Text="{loc:T Common.AudioManager}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FileSharingButton" Click="FileSharingButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="28" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE72D;" />
                            <TextBlock Text="WindowWise Drop" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WindowLayoutsButton" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Path Width="24" Height="24" Data="{StaticResource LayoutIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Style="{StaticResource FeatureIconStyle}" />
                            </Viewbox>
                            <TextBlock Text="{loc:T Common.WindowLayouts}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                    <Button Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="28" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                            <TextBlock Text="{loc:T Common.Settings}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="26,10,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="WindowWise 0.1.0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="32,0,24,0" LastChildFill="True">
                    <controls:AccountMenu x:Name="AccountHeader" DockPanel.Dock="Right" VerticalAlignment="Center" />
                    <controls:LanguageSelector DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="PageTitleText" Text="{loc:T Common.Overview}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ContentControl x:Name="MainContent" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
