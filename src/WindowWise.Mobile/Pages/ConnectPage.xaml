<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WindowWise.Mobile.Pages.ConnectPage">
  <Grid RowDefinitions="*,Auto" Padding="20,16,20,26">
    <ScrollView>
      <VerticalStackLayout Spacing="0" Padding="0,24,0,0">
        <Grid WidthRequest="120" HeightRequest="120" HorizontalOptions="Center">
          <Ellipse WidthRequest="120" HeightRequest="120">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.5,0.4" Radius="0.5">
                <GradientStop Color="#597FA2FF" Offset="0" />
                <GradientStop Color="#007FA2FF" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Border WidthRequest="64" HeightRequest="64" Background="{StaticResource TileGradient}" StrokeThickness="0"
                  StrokeShape="RoundRectangle 20" HorizontalOptions="Center" VerticalOptions="Center">
            <Border.Shadow><Shadow Brush="#4C74F0" Opacity="0.5" Radius="22" Offset="0,8" /></Border.Shadow>
            <Image Source="icon_drop.png" WidthRequest="30" HeightRequest="30" />
          </Border>
        </Grid>
        <Label Text="Connect to your PC" Style="{StaticResource Title}" HorizontalOptions="Center" Margin="0,22,0,0" />
        <Label Text="Open Drop on your PC and create a room.&#10;Enter the 20-character code below." Style="{StaticResource Caption}"
               FontSize="14" HorizontalTextAlignment="Center" LineHeight="1.35" Margin="0,8,0,0" />

        <!-- The code shows as five groups of four. A transparent text box on top takes the input. -->
        <Grid Margin="0,26,0,0" HeightRequest="48">
          <Grid x:Name="CodeBoxes" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="7" />
          <Entry x:Name="CodeEntry" MaxLength="20" Opacity="0.02" TextColor="Transparent" TextTransform="Uppercase" Keyboard="Text"
                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 TextChanged="Code_TextChanged" Focused="Code_FocusChanged" Unfocused="Code_FocusChanged" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto,*" Margin="4,22">
          <BoxView HeightRequest="1" Color="{StaticResource Divider}" VerticalOptions="Center" />
          <Label Grid.Column="1" Text="or" Style="{StaticResource Caption}" TextColor="{StaticResource Faint}" Margin="12,0" />
          <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource Divider}" VerticalOptions="Center" />
        </Grid>

        <Button x:Name="CreateButton" Text="＋  Create a room on this phone" Style="{StaticResource GhostButton}" HeightRequest="50" CornerRadius="25" Clicked="Create_Clicked" />
        <Border x:Name="CreatedCard" Style="{StaticResource GlassCard}" Padding="16" Margin="0,14,0,0" IsVisible="False">
          <VerticalStackLayout Spacing="6">
            <Label Text="Enter this code on your PC" Style="{StaticResource Caption}" />
            <Label x:Name="CreatedCode" FontFamily="monospace" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
          </VerticalStackLayout>
        </Border>
        <HorizontalStackLayout x:Name="StatusRow" Spacing="10" Margin="0,16,0,0" HorizontalOptions="Center" IsVisible="False">
          <ActivityIndicator x:Name="Busy" IsRunning="True" WidthRequest="18" HeightRequest="18" />
          <Label x:Name="StatusText" Style="{StaticResource Caption}" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <Label Text="Files go directly between devices. Nothing is stored on a server." Style="{StaticResource Caption}"
               FontSize="12" TextColor="{StaticResource Faint}" HorizontalTextAlignment="Center" Margin="0,14,0,0" />
      </VerticalStackLayout>
    </ScrollView>
    <Button x:Name="JoinButton" Grid.Row="1" Text="Join room" Style="{StaticResource GoButton}" IsEnabled="False" Clicked="Join_Clicked" />
  </Grid>
</ContentPage>
