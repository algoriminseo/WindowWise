<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>WindowWise.Mobile</RootNamespace>
    <ApplicationTitle>WindowWise Drop</ApplicationTitle>
    <ApplicationId>com.windowwise.drop</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <!-- Use the Java and Android SDK that Android Studio installs when none is configured. -->
  <PropertyGroup>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And '$(JAVA_HOME)' == '' And Exists('$(ProgramFiles)\Android\Android Studio\jbr')">$(ProgramFiles)\Android\Android Studio\jbr</JavaSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#111B2A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#111B2A" BaseSize="96,96" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="SIPSorcery" Version="10.0.18-pre" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.1" />
  </ItemGroup>

  <!-- Use the desktop app's transfer code as is, so both sides always speak the same protocol. -->
  <ItemGroup>
    <Compile Include="..\WindowWise.App\Models\SharedFileInfo.cs" Link="Shared\SharedFileInfo.cs" />
    <Compile Include="..\WindowWise.App\Models\SignalingMessage.cs" Link="Shared\SignalingMessage.cs" />
    <Compile Include="..\WindowWise.App\Services\RemoteSignalingClient.cs" Link="Shared\RemoteSignalingClient.cs" />
    <Compile Include="..\WindowWise.App\Services\RoomPairingSession.cs" Link="Shared\RoomPairingSession.cs" />
    <Compile Include="..\WindowWise.App\Services\WebRtcDataChannelService.cs" Link="Shared\WebRtcDataChannelService.cs" />
    <Compile Include="..\WindowWise.App\Services\WebRtcFileTransferService.cs" Link="Shared\WebRtcFileTransferService.cs" />
    <Compile Include="..\WindowWise.App\Services\RemoteShareList.cs" Link="Shared\RemoteShareList.cs" />
    <Compile Include="..\WindowWise.App\Services\IceServerSettings.cs" Link="Shared\IceServerSettings.cs" />
    <Compile Include="..\WindowWise.App\Services\TurnCredentialsClient.cs" Link="Shared\TurnCredentialsClient.cs" />
  </ItemGroup>
</Project>
